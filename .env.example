# Copy to .env and fill in real values: cp .env.example .env
# Makefile loads .env automatically (-include .env) and exports all vars.

# --- Provider / SDK auth (used by the provider and acceptance tests) ---
# API endpoint of the vStack Cloud Panel
VCP_API_URL=https://api.example.com
# API token for the project
VCP_API_TOKEN=

# --- Acceptance tests (make testacc) ---
# Location id required by acceptance tests (see internal/acctest/acctest.go)
VCP_LOCATION_ID=
# OS image id used by server acceptance tests (must exist in VCP_LOCATION_ID)
VCP_IMAGE_ID=
# Optional: a second, different location id. Without it the "changing the
# location forces a replace" tests in affinity_group and isolated_network skip.
# VCP_LOCATION_ID_ALT=

# --- VMware Cloud acceptance tests (internal/services/vmware) ---
# VMware is a separate service with its own catalog, so it has its own location
# and image, not the VCP_LOCATION_ID / VCP_IMAGE_ID above. Read them from
# `terraform plan` on the vcp_vmware_locations / vcp_vmware_images data sources,
# or from the panel.
VCP_VMWARE_LOCATION_ID=
VCP_VMWARE_IMAGE_ID=
# Optional: order a public network in the network tests. It consumes one of the
# location's free address blocks, and a location that has none answers -12043,
# so the test is opt-in.
# VCP_VMWARE_TEST_PUBLIC_NETWORK=1

# --- Go modules ---
# The SDK (github.com/itglobalcom/vstack-cloud-panel-sdk) is published publicly
# and pinned in go.mod, so no GOPRIVATE is needed. To develop against a local
# SDK checkout instead, use go.work — see CONTRIBUTING.md.
